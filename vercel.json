{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    },
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/api/learning/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "^(?:www[.])?eyepek[.]com$"
        }
      ],
      "dest": "https://eyepek-eyepeks-projects.vercel.app/api/learning/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
